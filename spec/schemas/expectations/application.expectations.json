{
  "$schema": "../base/connection-expectations.schema.json",
  "layer": "application",
  "expectations": [
    {
      "id": "application.applicationfunction.performed-by",
      "source": "application.applicationfunction",
      "rationale": "Components are assigned to the functions they perform; a function no component performs has no code behind it.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "assigned-to",
          "other": {
            "types": ["application.applicationcomponent"]
          }
        }
      ]
    },
    {
      "id": "application.applicationprocess.performed-by",
      "source": "application.applicationprocess",
      "rationale": "Components and collaborations are assigned to the processes they perform; a process nothing performs has no code behind it.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "assigned-to",
          "other": {
            "types": [
              "application.applicationcomponent",
              "application.applicationcollaboration"
            ]
          }
        }
      ]
    },
    {
      "id": "application.applicationinteraction.performed-by",
      "source": "application.applicationinteraction",
      "rationale": "An interaction is behaviour performed together by a collaboration assigned to it.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "assigned-to",
          "other": {
            "types": ["application.applicationcollaboration"]
          }
        }
      ]
    },
    {
      "id": "application.applicationservice.realized-by",
      "source": "application.applicationservice",
      "rationale": "Functions, processes and interactions realize application services (a component may realize one directly); a service nothing realizes is not implemented.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "realizes",
          "other": {
            "types": [
              "application.applicationfunction",
              "application.applicationprocess",
              "application.applicationinteraction",
              "application.applicationcomponent",
              "application.applicationcollaboration"
            ]
          }
        }
      ]
    },
    {
      "id": "application.applicationinterface.provided-by",
      "source": "application.applicationinterface",
      "rationale": "A component provides the interfaces its code declares, or is assigned to one it handles; an interface no component provides or handles has no implementation.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "provides",
          "other": {
            "types": [
              "application.applicationcomponent",
              "application.applicationcollaboration"
            ]
          }
        },
        {
          "direction": "incoming",
          "predicate": "assigned-to",
          "other": {
            "types": ["application.applicationcomponent"]
          }
        }
      ]
    },
    {
      "id": "application.dataobject.accessed",
      "source": "application.dataobject",
      "rationale": "Behaviour and components access the data objects they process; a data object nothing in the application reads or writes is dead structure.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "accesses",
          "other": {
            "layers": ["application"]
          }
        }
      ]
    }
  ]
}
