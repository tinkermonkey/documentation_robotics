{
  "$schema": "../base/connection-expectations.schema.json",
  "layer": "ux",
  "expectations": [
    {
      "id": "ux.view.routed",
      "source": "ux.view",
      "rationale": "A route maps to the view it renders; a view no route renders cannot be reached.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "maps-to",
          "other": {
            "types": ["navigation.route"]
          }
        }
      ]
    }
  ]
}
