{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schemaproperty composes Stringschema",
  "description": "The property's value is a string whose length, pattern or format is written in place on the property, so the string schema is part of it. A named, reusable string type is a schema definition the property references.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.schemaproperty.composes.data-model.stringschema"
    },
    "source_spec_node_id": {
      "const": "data-model.schemaproperty"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.stringschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
