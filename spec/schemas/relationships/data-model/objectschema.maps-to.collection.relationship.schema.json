{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Objectschema maps-to Collection",
  "description": "The object schema describes the same records that the collection or table stores, such as an entity class and its table. Use the schema definition's maps-to instead when the stored type is a named definition rather than an object schema.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.objectschema.maps-to.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "data-model.objectschema"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-store.collection"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "maps-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
