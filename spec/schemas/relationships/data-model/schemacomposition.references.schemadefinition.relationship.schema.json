{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schemacomposition references Schemadefinition",
  "description": "One branch of the composition is a named definition that exists apart from it and is reused elsewhere, so the composition references it rather than owning it. Use composes instead for a branch written in place.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.schemacomposition.references.data-model.schemadefinition"
    },
    "source_spec_node_id": {
      "const": "data-model.schemacomposition"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.schemadefinition"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
