{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schemaproperty References Objectschema",
  "description": "The property's value is an object of a type declared elsewhere, such as Pet.owner typed as the Owner entity, so the property points at that object schema rather than owning it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.schemaproperty.references.data-model.objectschema"
    },
    "source_spec_node_id": {
      "const": "data-model.schemaproperty"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.objectschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
