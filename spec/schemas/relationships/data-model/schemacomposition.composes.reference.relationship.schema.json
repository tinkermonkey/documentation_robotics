{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schemacomposition composes Reference",
  "description": "One branch of the composition is a $ref written in place, the usual form of an allOf base or a oneOf variant; the reference in turn references the type it points at.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.schemacomposition.composes.data-model.reference"
    },
    "source_spec_node_id": {
      "const": "data-model.schemacomposition"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.reference"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
