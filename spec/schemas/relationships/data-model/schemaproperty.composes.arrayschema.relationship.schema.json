{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schemaproperty composes Arrayschema",
  "description": "The property's value is a list whose constraints (items, length, uniqueness) are written in place on the property, so the array schema is part of it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.schemaproperty.composes.data-model.arrayschema"
    },
    "source_spec_node_id": {
      "const": "data-model.schemaproperty"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.arrayschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
