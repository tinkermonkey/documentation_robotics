{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Objectschema realizes Dataobject",
  "description": "The object schema gives a persisted or published shape to an application data object, such as the entity class or published schema behind a data structure the application passes around.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.objectschema.realizes.application.dataobject"
    },
    "source_spec_node_id": {
      "const": "data-model.objectschema"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "application.dataobject"
    },
    "destination_layer": {
      "const": "application"
    },
    "predicate": {
      "const": "realizes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
