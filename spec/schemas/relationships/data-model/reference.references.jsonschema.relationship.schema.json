{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reference references Jsonschema",
  "description": "The $ref points at another schema document by its $id or URI, delegating validation to that document's root schema.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.reference.references.data-model.jsonschema"
    },
    "source_spec_node_id": {
      "const": "data-model.reference"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.jsonschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
