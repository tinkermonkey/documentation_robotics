{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Objectschema specializes Objectschema",
  "description": "The object schema is a subtype of another object schema, inheriting its properties and adding its own, such as a subclass of an entity class or a schema built by extending a base schema. This is the data-model's only subtyping predicate.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.objectschema.specializes.data-model.objectschema"
    },
    "source_spec_node_id": {
      "const": "data-model.objectschema"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.objectschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "specializes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
