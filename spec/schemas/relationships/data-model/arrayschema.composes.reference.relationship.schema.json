{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arrayschema composes Reference",
  "description": "The array's items keyword is a $ref written in place, so the reference node is part of the array schema; the reference in turn references the type it points at.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.arrayschema.composes.data-model.reference"
    },
    "source_spec_node_id": {
      "const": "data-model.arrayschema"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.reference"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
