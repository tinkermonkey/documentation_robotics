{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jsonschema composes Arrayschema",
  "description": "The document's root schema is an array schema, which exists only as part of the document.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.jsonschema.composes.data-model.arrayschema"
    },
    "source_spec_node_id": {
      "const": "data-model.jsonschema"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.arrayschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
