{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schemaproperty references Schemadefinition",
  "description": "The property's value takes a named, reusable definition, such as a shared enumeration or value type reached by $ref.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.schemaproperty.references.data-model.schemadefinition"
    },
    "source_spec_node_id": {
      "const": "data-model.schemaproperty"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.schemadefinition"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
