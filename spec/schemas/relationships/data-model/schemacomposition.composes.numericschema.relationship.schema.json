{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schemacomposition composes Numericschema",
  "description": "One branch of the composition is a numeric schema written in place, such as a range alternative in an anyOf, which is part of the composition.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.schemacomposition.composes.data-model.numericschema"
    },
    "source_spec_node_id": {
      "const": "data-model.schemacomposition"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.numericschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
