{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Objectschema satisfies Securityconstraints",
  "description": "The object schema's structure meets a security constraint on the data, such as omitting or separating fields that a constraint forbids exposing together.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.objectschema.satisfies.security.securityconstraints"
    },
    "source_spec_node_id": {
      "const": "data-model.objectschema"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "security.securityconstraints"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "satisfies"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
