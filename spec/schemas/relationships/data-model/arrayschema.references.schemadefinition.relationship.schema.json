{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arrayschema references Schemadefinition",
  "description": "The array's items are a named, reusable definition reached by $ref or by name, so the array points at a type it does not own. Use composes instead when the item schema is written in place.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-model.arrayschema.references.data-model.schemadefinition"
    },
    "source_spec_node_id": {
      "const": "data-model.arrayschema"
    },
    "source_layer": {
      "const": "data-model"
    },
    "destination_spec_node_id": {
      "const": "data-model.schemadefinition"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
