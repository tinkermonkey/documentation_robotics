{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Threat influence Data Classification",
  "description": "The threat raises the classification, and so the protection, of the data it targets.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "security.threat.influence.security.dataclassification"
    },
    "source_spec_node_id": {
      "const": "security.threat"
    },
    "source_layer": {
      "const": "security"
    },
    "destination_spec_node_id": {
      "const": "security.dataclassification"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
