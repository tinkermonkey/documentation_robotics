{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role references Businessrole",
  "description": "The security role stands for the business role in access decisions.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "security.role.references.business.businessrole"
    },
    "source_spec_node_id": {
      "const": "security.role"
    },
    "source_layer": {
      "const": "security"
    },
    "destination_spec_node_id": {
      "const": "business.businessrole"
    },
    "destination_layer": {
      "const": "business"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
