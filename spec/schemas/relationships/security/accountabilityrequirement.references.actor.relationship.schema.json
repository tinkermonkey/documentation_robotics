{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Accountabilityrequirement references Actor",
  "description": "The obligation applies to the actor, whose actions must be provably attributable.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "security.accountabilityrequirement.references.security.actor"
    },
    "source_spec_node_id": {
      "const": "security.accountabilityrequirement"
    },
    "source_layer": {
      "const": "security"
    },
    "destination_spec_node_id": {
      "const": "security.actor"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
