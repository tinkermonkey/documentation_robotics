{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Policyrule triggers Policyaction",
  "description": "The action is carried out when the rule matches, such as a step-up challenge.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "security.policyrule.triggers.security.policyaction"
    },
    "source_spec_node_id": {
      "const": "security.policyrule"
    },
    "source_layer": {
      "const": "security"
    },
    "destination_spec_node_id": {
      "const": "security.policyaction"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "triggers"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
