{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bindingofduty references Evidence",
  "description": "The evidence shows who performed each bound step.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "security.bindingofduty.references.security.evidence"
    },
    "source_spec_node_id": {
      "const": "security.bindingofduty"
    },
    "source_layer": {
      "const": "security"
    },
    "destination_spec_node_id": {
      "const": "security.evidence"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
