{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Condition aggregates Accesscondition",
  "description": "The condition combines the access condition with others into one reusable expression.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "security.condition.aggregates.security.accesscondition"
    },
    "source_spec_node_id": {
      "const": "security.condition"
    },
    "source_layer": {
      "const": "security"
    },
    "destination_spec_node_id": {
      "const": "security.accesscondition"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "aggregates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
