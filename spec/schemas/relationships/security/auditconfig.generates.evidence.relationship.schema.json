{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auditconfig generates Evidence",
  "description": "The audit configuration writes this kind of evidence, such as an audit trail entry.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "security.auditconfig.generates.security.evidence"
    },
    "source_spec_node_id": {
      "const": "security.auditconfig"
    },
    "source_layer": {
      "const": "security"
    },
    "destination_spec_node_id": {
      "const": "security.evidence"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "generates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
