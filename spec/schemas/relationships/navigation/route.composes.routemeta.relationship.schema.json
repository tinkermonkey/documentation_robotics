{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Route composes Routemeta",
  "description": "The route meta belongs to the route and is read by the router for it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.route.composes.navigation.routemeta"
    },
    "source_spec_node_id": {
      "const": "navigation.route"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "navigation.routemeta"
    },
    "destination_layer": {
      "const": "navigation"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
