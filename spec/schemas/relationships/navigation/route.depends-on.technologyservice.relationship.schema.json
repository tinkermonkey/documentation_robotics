{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Route depends-on Technologyservice",
  "description": "The route needs a technology service, such as a CDN that serves its bundle.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.route.depends-on.technology.technologyservice"
    },
    "source_spec_node_id": {
      "const": "navigation.route"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "technology.technologyservice"
    },
    "destination_layer": {
      "const": "technology"
    },
    "predicate": {
      "const": "depends-on"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
