{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Route navigates-to Route",
  "description": "The route forwards to another route without a modelled transition, such as a redirect or alias entry.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.route.navigates-to.navigation.route"
    },
    "source_spec_node_id": {
      "const": "navigation.route"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "navigation.route"
    },
    "destination_layer": {
      "const": "navigation"
    },
    "predicate": {
      "const": "navigates-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
