{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Navigationflow realizes Applicationprocess",
  "description": "The flow is the user-facing side of an application process, such as a checkout flow for the order-placement process.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.navigationflow.realizes.application.applicationprocess"
    },
    "source_spec_node_id": {
      "const": "navigation.navigationflow"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "application.applicationprocess"
    },
    "destination_layer": {
      "const": "application"
    },
    "predicate": {
      "const": "realizes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
