{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Breadcrumbconfig references Routemeta",
  "description": "The breadcrumb configuration reads labels from the route meta, such as a breadcrumb title declared on each route.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.breadcrumbconfig.references.navigation.routemeta"
    },
    "source_spec_node_id": {
      "const": "navigation.breadcrumbconfig"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "navigation.routemeta"
    },
    "destination_layer": {
      "const": "navigation"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
