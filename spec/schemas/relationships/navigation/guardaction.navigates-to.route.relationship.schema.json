{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guardaction navigates-to Route",
  "description": "The guard action redirects the user to the route when the guard denies navigation, such as the sign-in route.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.guardaction.navigates-to.navigation.route"
    },
    "source_spec_node_id": {
      "const": "navigation.guardaction"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "navigation.route"
    },
    "destination_layer": {
      "const": "navigation"
    },
    "predicate": {
      "const": "navigates-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
