{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Route maps-to Pathitem",
  "description": "The client route mirrors a server path, such as /orders/:id and GET /orders/{id}. Use the operation's serves instead when the route calls the operation.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.route.maps-to.api.pathitem"
    },
    "source_spec_node_id": {
      "const": "navigation.route"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "api.pathitem"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "maps-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
