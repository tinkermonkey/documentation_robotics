{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Navigationflow satisfies Bindingofduty",
  "description": "The flow keeps the bound steps with one actor, as the binding-of-duty rule requires, such as the same user confirming the order they started.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.navigationflow.satisfies.security.bindingofduty"
    },
    "source_spec_node_id": {
      "const": "navigation.navigationflow"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "security.bindingofduty"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "satisfies"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
