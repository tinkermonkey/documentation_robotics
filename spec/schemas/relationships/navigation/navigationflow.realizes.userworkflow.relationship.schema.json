{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Navigationflow realizes Userworkflow",
  "description": "The flow is the navigation implementation of the product user workflow; this is how navigation reaches the business and motivation layers.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.navigationflow.realizes.product.userworkflow"
    },
    "source_spec_node_id": {
      "const": "navigation.navigationflow"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "product.userworkflow"
    },
    "destination_layer": {
      "const": "product"
    },
    "predicate": {
      "const": "realizes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
