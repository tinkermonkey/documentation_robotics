{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guardcondition references Routemeta",
  "description": "The guard condition reads the access hints in route meta, such as requiresAuth or the roles a route lists.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "navigation.guardcondition.references.navigation.routemeta"
    },
    "source_spec_node_id": {
      "const": "navigation.guardcondition"
    },
    "source_layer": {
      "const": "navigation"
    },
    "destination_spec_node_id": {
      "const": "navigation.routemeta"
    },
    "destination_layer": {
      "const": "navigation"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
