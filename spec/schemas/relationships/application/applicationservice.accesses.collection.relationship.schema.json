{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationservice accesses Collection",
  "description": "The service reads or writes the collection's records as part of what it offers.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationservice.accesses.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "application.applicationservice"
    },
    "source_layer": {
