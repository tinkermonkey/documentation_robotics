{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationservice accesses Database",
  "description": "The service reads or writes data held in the database, named at the level of the database rather than its collections. Use accesses collection instead when the collections are modelled.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationservice.accesses.data-store.database"
    },
    "source_spec_node_id": {
      "const": "application.applicationservice"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "data-store.database"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "accesses"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
