{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationcomponent assigned-to Applicationprocess",
  "description": "The component is the active structure that performs the process; the process's ordered steps run inside this component.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationcomponent.assigned-to.application.applicationprocess"
    },
    "source_spec_node_id": {
      "const": "application.applicationcomponent"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "application.applicationprocess"
    },
    "destination_layer": {
      "const": "application"
    },
    "predicate": {
      "const": "assigned-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
