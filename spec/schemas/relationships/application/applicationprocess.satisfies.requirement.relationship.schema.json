{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationprocess satisfies Requirement",
  "description": "The application process meets the requirement, for example a layout pipeline meeting a non-blocking first-paint requirement.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationprocess.satisfies.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "application.applicationprocess"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "satisfies"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
