{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationcomponent accesses Objectschema",
  "description": "The component creates, reads, updates or deletes instances of the object schema, such as a repository or service class working with an entity class. Use accesses to an application data object instead when the structure is not part of the data model.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationcomponent.accesses.data-model.objectschema"
    },
    "source_spec_node_id": {
      "const": "application.applicationcomponent"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "data-model.objectschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "accesses"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
