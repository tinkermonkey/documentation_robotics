{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationfunction accesses View",
  "description": "The function reads the view while it runs, such as a report query against a reporting view.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationfunction.accesses.data-store.view"
    },
    "source_spec_node_id": {
      "const": "application.applicationfunction"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "data-store.view"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "accesses"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
