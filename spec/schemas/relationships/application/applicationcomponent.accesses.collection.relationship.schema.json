{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationcomponent accesses Collection",
  "description": "The component reads or writes the collection's records, such as a repository or DAO class. Use the object schema's maps-to instead to say which entity the collection stores.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationcomponent.accesses.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "application.applicationcomponent"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "data-store.collection"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "accesses"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
