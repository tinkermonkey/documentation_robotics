{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationcomponent accesses Database",
  "description": "The component connects to the database as a whole, such as a repository layer, ORM session or connection pool bound to one database. Use accesses collection instead when the component's reads and writes are to named collections.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationcomponent.accesses.data-store.database"
    },
    "source_spec_node_id": {
      "const": "application.applicationcomponent"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "data-store.database"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "accesses"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
