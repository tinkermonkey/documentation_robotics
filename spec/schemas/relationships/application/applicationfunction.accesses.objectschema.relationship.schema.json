{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationfunction accesses Objectschema",
  "description": "The function reads or writes instances of the object schema while it runs, such as a handler that loads and saves an entity. Use accesses to an application data object instead when the structure is not part of the data model.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationfunction.accesses.data-model.objectschema"
    },
    "source_spec_node_id": {
      "const": "application.applicationfunction"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "data-model.objectschema"
    },
    "destination_layer": {
      "const": "data-model"
    },
    "predicate": {
      "const": "accesses"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
