{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationfunction triggers Message",
  "description": "The application function sends the message: it constructs it and puts it on the channel for the receiver.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationfunction.triggers.application.message"
    },
    "source_spec_node_id": {
      "const": "application.applicationfunction"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "application.message"
    },
    "destination_layer": {
      "const": "application"
    },
    "predicate": {
      "const": "triggers"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  },
  "x-dr-evidence": [
    "The function's implementing methods construct the message and pass it to a send, post, publish or enqueue call."
  ]
}
