{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Applicationfunction accesses Collection",
  "description": "The function reads or writes the collection's records while it runs, such as a repository method running a query. Use an access pattern instead when the query shape itself is modelled.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "application.applicationfunction.accesses.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "application.applicationfunction"
    },
    "source_layer": {
      "const": "application"
    },
    "destination_spec_node_id": {
      "const": "data-store.collection"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "accesses"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
