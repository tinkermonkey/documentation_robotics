{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona references Stakeholder",
  "description": "The persona is a design archetype for a group the stakeholder represents; it points to the stakeholder whose concerns its users share.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.persona.references.motivation.stakeholder"
    },
    "source_spec_node_id": {
      "const": "product.persona"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "motivation.stakeholder"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
