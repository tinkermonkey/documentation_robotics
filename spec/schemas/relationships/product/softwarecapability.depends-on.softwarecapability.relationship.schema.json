{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Softwarecapability depends-on Capability",
  "description": "The software capability needs the other capability of the platform to work, such as full-text search depending on document indexing.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.softwarecapability.depends-on.product.softwarecapability"
    },
    "source_spec_node_id": {
      "const": "product.softwarecapability"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "product.softwarecapability"
    },
    "destination_layer": {
      "const": "product"
    },
    "predicate": {
      "const": "depends-on"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
