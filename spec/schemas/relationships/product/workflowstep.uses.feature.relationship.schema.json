{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflowstep uses Feature",
  "description": "At this step the user exercises the feature; a workflow reaches features, and through them software capabilities, only through its steps.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.workflowstep.uses.product.feature"
    },
    "source_spec_node_id": {
      "const": "product.workflowstep"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "product.feature"
    },
    "destination_layer": {
      "const": "product"
    },
    "predicate": {
      "const": "uses"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
