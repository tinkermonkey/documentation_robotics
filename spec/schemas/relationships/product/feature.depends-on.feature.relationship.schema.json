{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature depends-on Feature",
  "description": "Defines relationship: product.feature depends-on product.feature",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.feature.depends-on.product.feature"
    },
    "source_spec_node_id": {
      "const": "product.feature"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "product.feature"
    },
    "destination_layer": {
      "const": "product"
    },
    "predicate": {
      "const": "depends-on"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
