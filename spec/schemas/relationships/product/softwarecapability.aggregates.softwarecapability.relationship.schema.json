{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Softwarecapability aggregates Capability",
  "description": "The narrower software capability is part of the wider one in the platform's capability map; it keeps its own identity and may be grouped under more than one parent.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.softwarecapability.aggregates.product.softwarecapability"
    },
    "source_spec_node_id": {
      "const": "product.softwarecapability"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "product.softwarecapability"
    },
    "destination_layer": {
      "const": "product"
    },
    "predicate": {
      "const": "aggregates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
