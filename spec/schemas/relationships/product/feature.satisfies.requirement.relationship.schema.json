{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature satisfies Requirement",
  "description": "The feature is how the product meets the requirement, so the requirement is fulfilled once the feature ships.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.feature.satisfies.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "product.feature"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "satisfies"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
