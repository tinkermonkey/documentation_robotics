{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Softwarecapability realizes BusinessFunction",
  "description": "The software capability is how the platform carries out the business function, such as saving documents to files realizing the business function of sharing data. This is the product layer's main link to the business layer.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.softwarecapability.realizes.business.businessfunction"
    },
    "source_spec_node_id": {
      "const": "product.softwarecapability"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "business.businessfunction"
    },
    "destination_layer": {
      "const": "business"
    },
    "predicate": {
      "const": "realizes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
