{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature realizes Softwarecapability",
  "description": "The feature is one concrete, user-visible way the software exercises the capability, such as an export button realizing the ability to save documents to files.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.feature.realizes.product.softwarecapability"
    },
    "source_spec_node_id": {
      "const": "product.feature"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "product.softwarecapability"
    },
    "destination_layer": {
      "const": "product"
    },
    "predicate": {
      "const": "realizes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
