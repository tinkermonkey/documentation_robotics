{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona references Businessrole",
  "description": "The persona describes a kind of person who holds the business role; it points to the role rather than performing or serving it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.persona.references.business.businessrole"
    },
    "source_spec_node_id": {
      "const": "product.persona"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "business.businessrole"
    },
    "destination_layer": {
      "const": "business"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
