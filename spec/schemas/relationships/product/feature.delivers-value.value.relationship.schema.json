{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature delivers-value Value",
  "description": "Users of the feature gain the value; the value is the reason the feature is worth building.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "product.feature.delivers-value.motivation.value"
    },
    "source_spec_node_id": {
      "const": "product.feature"
    },
    "source_layer": {
      "const": "product"
    },
    "destination_spec_node_id": {
      "const": "motivation.value"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "delivers-value"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
