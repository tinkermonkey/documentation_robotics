{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "View composes Index",
  "description": "The index is maintained over the view's rows, such as an index on a materialized view.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.view.composes.data-store.index"
    },
    "source_spec_node_id": {
      "const": "data-store.view"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.index"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
