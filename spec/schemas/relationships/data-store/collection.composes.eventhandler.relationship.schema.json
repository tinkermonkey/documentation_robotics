{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection composes Eventhandler",
  "description": "The event handler is attached to the collection, such as a trigger declared on a table or a change stream opened on a collection; it is dropped with it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.collection.composes.data-store.eventhandler"
    },
    "source_spec_node_id": {
      "const": "data-store.collection"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.eventhandler"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
