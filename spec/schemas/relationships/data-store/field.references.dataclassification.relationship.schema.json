{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Field references Dataclassification",
  "description": "The field is handled at the protection level of the data classification, such as a column holding personal data.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.field.references.security.dataclassification"
    },
    "source_spec_node_id": {
      "const": "data-store.field"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "security.dataclassification"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
