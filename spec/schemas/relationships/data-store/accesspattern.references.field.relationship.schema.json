{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Accesspattern references Field",
  "description": "The access pattern names the field in its key, sort or filter condition, such as customer_id in 'orders by customer'.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.accesspattern.references.data-store.field"
    },
    "source_spec_node_id": {
      "const": "data-store.accesspattern"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.field"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
