{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Field composes Field",
  "description": "The field contains nested fields, such as a document sub-object or a composite column type.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.field.composes.data-store.field"
    },
    "source_spec_node_id": {
      "const": "data-store.field"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.field"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
