{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection Composes Collection",
  "description": "The collection contains a partition or sub-collection that exists only as part of it, such as a table partition or a subcollection under a document.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.collection.composes.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "data-store.collection"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.collection"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
