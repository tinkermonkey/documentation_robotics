{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Accesspattern satisfies Requirement",
  "description": "The access pattern meets a requirement on data access, such as a lookup that must return within a latency budget.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.accesspattern.satisfies.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "data-store.accesspattern"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "satisfies"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
