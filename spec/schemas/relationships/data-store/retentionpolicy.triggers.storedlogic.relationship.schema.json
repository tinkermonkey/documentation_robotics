{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retentionpolicy triggers Storedlogic",
  "description": "The policy runs the stored logic that carries out its action, such as a scheduled purge or downsampling job.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.retentionpolicy.triggers.data-store.storedlogic"
    },
    "source_spec_node_id": {
      "const": "data-store.retentionpolicy"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.storedlogic"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "triggers"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
