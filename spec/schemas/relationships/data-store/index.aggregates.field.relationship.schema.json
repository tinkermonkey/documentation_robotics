{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Index Aggregates Field",
  "description": "The index is keyed on the field; the field exists apart from any index that covers it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.index.aggregates.data-store.field"
    },
    "source_spec_node_id": {
      "const": "data-store.index"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.field"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "aggregates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
