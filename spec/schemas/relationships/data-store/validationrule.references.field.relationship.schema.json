{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validationrule references Field",
  "description": "The rule constrains the field, such as a CHECK on a column or a UNIQUE constraint over several columns.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.validationrule.references.data-store.field"
    },
    "source_spec_node_id": {
      "const": "data-store.validationrule"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.field"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
