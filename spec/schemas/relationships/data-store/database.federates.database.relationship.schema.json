{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Database federates Database",
  "description": "The database presents another database's data as part of its own without copying it, such as a foreign data wrapper or a linked server. Use replicates instead when the data is copied.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.database.federates.data-store.database"
    },
    "source_spec_node_id": {
      "const": "data-store.database"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.database"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "federates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
