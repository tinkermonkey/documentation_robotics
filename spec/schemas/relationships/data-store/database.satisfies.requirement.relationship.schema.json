{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Database satisfies Requirement",
  "description": "The database meets a requirement on storage, such as point-in-time recovery or a durability target.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.database.satisfies.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "data-store.database"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "satisfies"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
