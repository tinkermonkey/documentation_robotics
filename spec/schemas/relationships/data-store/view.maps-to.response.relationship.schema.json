{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "View maps-to Response",
  "description": "The view holds the same data an API response returns, such as a reporting view behind a summary endpoint.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.view.maps-to.api.response"
    },
    "source_spec_node_id": {
      "const": "data-store.view"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "api.response"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "maps-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
