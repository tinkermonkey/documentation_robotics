{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retentionpolicy archives-to Collection",
  "description": "Records the policy expires are moved to the collection, such as a cold-storage or archive table.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.retentionpolicy.archives-to.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "data-store.retentionpolicy"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.collection"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "archives-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
