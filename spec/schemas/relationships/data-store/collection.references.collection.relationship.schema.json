{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection references Collection",
  "description": "The collection points at another collection without containing it, such as a document collection holding references to records in another.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.collection.references.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "data-store.collection"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.collection"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
