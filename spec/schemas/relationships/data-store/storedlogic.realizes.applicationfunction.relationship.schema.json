{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Storedlogic realizes Applicationfunction",
  "description": "The stored logic implements an application function inside the database, such as a procedure that calculates an invoice total.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.storedlogic.realizes.application.applicationfunction"
    },
    "source_spec_node_id": {
      "const": "data-store.storedlogic"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "application.applicationfunction"
    },
    "destination_layer": {
      "const": "application"
    },
    "predicate": {
      "const": "realizes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
