{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Eventhandler references Field",
  "description": "The event handler watches the field, such as a trigger declared AFTER UPDATE OF status.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.eventhandler.references.data-store.field"
    },
    "source_spec_node_id": {
      "const": "data-store.eventhandler"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.field"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
