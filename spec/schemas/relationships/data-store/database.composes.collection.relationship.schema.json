{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Database Composes Collection",
  "description": "The collection lives directly in the database, for engines without namespaces. Use the namespace's composes instead when the engine has schemas or keyspaces.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.database.composes.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "data-store.database"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.collection"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
