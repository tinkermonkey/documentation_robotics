{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validationrule cascades-to Collection",
  "description": "Deleting or updating a referenced record cascades to the collection, through a foreign key with ON DELETE or ON UPDATE CASCADE. Only referential rules cascade.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.validationrule.cascades-to.data-store.collection"
    },
    "source_spec_node_id": {
      "const": "data-store.validationrule"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.collection"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "cascades-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
