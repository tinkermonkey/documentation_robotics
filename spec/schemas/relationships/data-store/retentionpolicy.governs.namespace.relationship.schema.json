{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retentionpolicy governs Namespace",
  "description": "The policy applies to every collection in the namespace, such as a default TTL on a keyspace.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.retentionpolicy.governs.data-store.namespace"
    },
    "source_spec_node_id": {
      "const": "data-store.retentionpolicy"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.namespace"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "governs"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
