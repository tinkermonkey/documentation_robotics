{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "View aggregates Field",
  "description": "The view exposes the field from its source collections; the field belongs to its collection.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.view.aggregates.data-store.field"
    },
    "source_spec_node_id": {
      "const": "data-store.view"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "data-store.field"
    },
    "destination_layer": {
      "const": "data-store"
    },
    "predicate": {
      "const": "aggregates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
