{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection realizes Businessobject",
  "description": "The collection stores the records of a business object, such as an orders table for the Order concept. This is a shortcut through the data model; when an object schema describes the records, it maps to the collection.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "data-store.collection.realizes.business.businessobject"
    },
    "source_spec_node_id": {
      "const": "data-store.collection"
    },
    "source_layer": {
      "const": "data-store"
    },
    "destination_spec_node_id": {
      "const": "business.businessobject"
    },
    "destination_layer": {
      "const": "business"
    },
    "predicate": {
      "const": "realizes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
