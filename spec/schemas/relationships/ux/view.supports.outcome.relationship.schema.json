{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "View supports Outcome",
  "description": "The view contributes to the outcome, such as faster checkout.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "ux.view.supports.motivation.outcome"
    },
    "source_spec_node_id": {
      "const": "ux.view"
    },
    "source_layer": {
      "const": "ux"
    },
    "destination_spec_node_id": {
      "const": "motivation.outcome"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "supports"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
