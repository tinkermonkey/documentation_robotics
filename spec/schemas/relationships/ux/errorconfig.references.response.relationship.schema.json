{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Errorconfig references Response",
  "description": "The error configuration handles the error response, such as a 409 conflict.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "ux.errorconfig.references.api.response"
    },
    "source_spec_node_id": {
      "const": "ux.errorconfig"
    },
    "source_layer": {
      "const": "ux"
    },
    "destination_spec_node_id": {
      "const": "api.response"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
