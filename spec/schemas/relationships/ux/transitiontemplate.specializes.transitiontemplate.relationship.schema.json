{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transitiontemplate specializes Transitiontemplate",
  "description": "The template is a variant of the more general motion, such as a slow fade of a fade.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "ux.transitiontemplate.specializes.ux.transitiontemplate"
    },
    "source_spec_node_id": {
      "const": "ux.transitiontemplate"
    },
    "source_layer": {
      "const": "ux"
    },
    "destination_spec_node_id": {
      "const": "ux.transitiontemplate"
    },
    "destination_layer": {
      "const": "ux"
    },
    "predicate": {
