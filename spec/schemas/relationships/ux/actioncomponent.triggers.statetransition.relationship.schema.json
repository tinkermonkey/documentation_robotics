{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Actioncomponent triggers Statetransition",
  "description": "Activating the control fires the state transition, such as 'Next' moving a wizard on.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "ux.actioncomponent.triggers.ux.statetransition"
    },
    "source_spec_node_id": {
      "const": "ux.actioncomponent"
    },
    "source_layer": {
      "const": "ux"
    },
    "destination_spec_node_id": {
      "const": "ux.statetransition"
    },
    "destination_layer": {
      "const": "ux"
    },
    "predicate": {
      "const": "triggers"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
