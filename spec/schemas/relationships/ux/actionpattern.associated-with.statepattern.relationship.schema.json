{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Actionpattern associated-with Statepattern",
  "description": "The action pattern is used with the state pattern, such as a confirm-then-toast pattern in a submit flow.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "ux.actionpattern.associated-with.ux.statepattern"
    },
    "source_spec_node_id": {
      "const": "ux.actionpattern"
    },
    "source_layer": {
      "const": "ux"
    },
    "destination_spec_node_id": {
      "const": "ux.statepattern"
    },
    "destination_layer": {
      "const": "ux"
    },
    "predicate": {
      "const": "associated-with"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
