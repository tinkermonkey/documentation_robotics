  "description": "The test case is written within the constraint, such as a test that must run against the mandated environment.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "testing.testcasesketch.satisfies.motivation.constraint"
