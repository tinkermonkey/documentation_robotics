{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Testcoveragetarget covers Objectschema",
  "description": "The target puts the object schema in test scope, such as its validation.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "testing.testcoveragetarget.covers.data-model.objectschema"
