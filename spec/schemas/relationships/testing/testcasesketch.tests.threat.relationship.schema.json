{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Testcasesketch tests Threat",
  "description": "The test case attempts the threat, such as a penetration or abuse-case test, when no countermeasure that blocks it is modelled. Use tests countermeasure instead when the test checks that a modelled control blocks the attack.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "testing.testcasesketch.tests.security.threat"
    },
    "source_spec_node_id": {
      "const": "testing.testcasesketch"
    },
    "source_layer": {
      "const": "testing"
    },
    "destination_spec_node_id": {
      "const": "security.threat"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "tests"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
