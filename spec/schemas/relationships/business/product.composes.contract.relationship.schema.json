{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product composes Contract",
  "description": "The contract states the terms of the product and exists only as part of it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "business.product.composes.business.contract"
    },
    "source_spec_node_id": {
      "const": "business.product"
    },
    "source_layer": {
      "const": "business"
    },
    "destination_spec_node_id": {
      "const": "business.contract"
    },
    "destination_layer": {
      "const": "business"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
