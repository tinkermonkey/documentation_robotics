{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Businessevent Triggers Businessprocess",
  "description": "The occurrence of the event is the start trigger that launches a run of the process's ordered steps; use it for the event a process waits for, not for a hand-off between processes, which is flows-to.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "business.businessevent.triggers.business.businessprocess"
    },
    "source_spec_node_id": {
      "const": "business.businessevent"
    },
    "source_layer": {
      "const": "business"
    },
    "destination_spec_node_id": {
      "const": "business.businessprocess"
    },
    "destination_layer": {
      "const": "business"
    },
    "predicate": {
      "const": "triggers"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
