{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Businessprocess ConstrainedBy Separationofduty",
  "description": "The separation-of-duty rule limits which roles may perform the process's steps, so that no one role carries a sensitive sequence end to end.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "business.businessprocess.constrained-by.security.separationofduty"
    },
    "source_spec_node_id": {
      "const": "business.businessprocess"
    },
    "source_layer": {
      "const": "business"
    },
    "destination_spec_node_id": {
      "const": "security.separationofduty"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "constrained-by"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
