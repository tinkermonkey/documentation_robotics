{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Businessprocess Flows To Businessprocess",
  "description": "When the upstream process completes or reaches a hand-off point, its work or result passes to the downstream process, which continues the end-to-end sequence; use it for the sequence between processes, and triggers only for an event.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "business.businessprocess.flows-to.business.businessprocess"
    },
    "source_spec_node_id": {
      "const": "business.businessprocess"
    },
    "source_layer": {
      "const": "business"
    },
    "destination_spec_node_id": {
      "const": "business.businessprocess"
    },
    "destination_layer": {
      "const": "business"
    },
    "predicate": {
      "const": "flows-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
