{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goal Influence Principle",
  "description": "The goal prompts or shapes a principle that guides decisions toward it, such as 'reduce time to market' leading to 'prefer managed services'.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.goal.influence.motivation.principle"
    },
    "source_spec_node_id": {
      "const": "motivation.goal"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.principle"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
