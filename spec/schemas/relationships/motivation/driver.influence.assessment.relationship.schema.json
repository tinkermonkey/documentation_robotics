{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Driver Influence Assessment",
  "description": "The driver prompts or frames an assessment, such as a new regulation prompting a compliance gap analysis. Use the assessment's association instead to record which driver an assessment evaluates.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.driver.influence.motivation.assessment"
    },
    "source_spec_node_id": {
      "const": "motivation.driver"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.assessment"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
