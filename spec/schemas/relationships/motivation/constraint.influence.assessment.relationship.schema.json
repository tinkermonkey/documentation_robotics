{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constraint Influence Assessment",
  "description": "The constraint changes a finding, such as a budget ceiling turning an option the assessment rated feasible into an infeasible one.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.constraint.influence.motivation.assessment"
    },
    "source_spec_node_id": {
      "const": "motivation.constraint"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.assessment"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
