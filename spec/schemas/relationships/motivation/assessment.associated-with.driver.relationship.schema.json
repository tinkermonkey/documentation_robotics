  "title": "Assessment associated-with Driver",
  "description": "The assessment evaluates the driver, such as a gap analysis of how far the organization is from meeting a new regulation. Use influence instead when the finding shapes a goal, requirement or principle.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.assessment.associated-with.motivation.driver"
    },
    "source_spec_node_id": {
      "const": "motivation.assessment"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
