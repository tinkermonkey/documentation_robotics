{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goal Influence Goal",
  "description": "One goal contributes to or conflicts with another without being part of it, such as 'reduce cost' working against 'improve resilience'.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.goal.influence.motivation.goal"
    },
    "source_spec_node_id": {
      "const": "motivation.goal"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.goal"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
