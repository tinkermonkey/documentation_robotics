{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assessment influence Outcome",
  "description": "The finding shapes an outcome, such as a measured gap that sets the target value of the outcome meant to close it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.assessment.influence.motivation.outcome"
    },
    "source_spec_node_id": {
      "const": "motivation.assessment"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.outcome"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
