{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Meaning Associated With Outcome",
  "description": "The meaning explains how a term in the outcome is interpreted, such as how 'resolved' is defined for a ticket-resolution target.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.meaning.associated-with.motivation.outcome"
    },
    "source_spec_node_id": {
      "const": "motivation.meaning"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.outcome"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "associated-with"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
