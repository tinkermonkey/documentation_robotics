{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Constraint specializes Constraint",
  "description": "The constraint is a narrower case of a more general constraint, such as 'EU data stays in Frankfurt' specializing 'EU data stays in the EU'.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.constraint.specializes.motivation.constraint"
    },
    "source_spec_node_id": {
      "const": "motivation.constraint"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.constraint"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "specializes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
