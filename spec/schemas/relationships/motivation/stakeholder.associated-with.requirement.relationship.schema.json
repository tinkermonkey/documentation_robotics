{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stakeholder associated-with Requirement",
  "description": "The stakeholder is concerned with the requirement, such as the user group a user story is written for.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.stakeholder.associated-with.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "motivation.stakeholder"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "associated-with"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
