{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Goal Aggregates Goal",
  "description": "The goal is made up of narrower sub-goals, each part of reaching it. Use specializes instead when the narrower goal is a variant of the general one rather than a part of it.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.goal.aggregates.motivation.goal"
    },
    "source_spec_node_id": {
      "const": "motivation.goal"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.goal"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "aggregates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
