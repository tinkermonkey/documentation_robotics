{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Value associated-with Principle",
  "description": "The value is what following the principle is worth, such as lower maintenance cost for 'prefer managed services'.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.value.associated-with.motivation.principle"
    },
    "source_spec_node_id": {
      "const": "motivation.value"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.principle"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "associated-with"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
