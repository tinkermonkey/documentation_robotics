{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stakeholder influence Goal",
  "description": "The stakeholder sets or shapes the goal. Use association instead when the stakeholder only has a stake in a goal it does not shape.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.stakeholder.influence.motivation.goal"
    },
    "source_spec_node_id": {
      "const": "motivation.stakeholder"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.goal"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
