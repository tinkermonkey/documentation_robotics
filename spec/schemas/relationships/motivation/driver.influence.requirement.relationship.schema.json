{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Driver Influence Requirement",
  "description": "The driver prompts a requirement directly, such as a regulation that a system must log consent. Use the goal and outcome links instead when the driver works through an intended end state.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.driver.influence.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "motivation.driver"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
