{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Meaning associated-with Principle",
  "description": "The meaning explains a term or concept the principle relies on, such as what counts as a 'managed service'.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.meaning.associated-with.motivation.principle"
    },
    "source_spec_node_id": {
      "const": "motivation.meaning"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.principle"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "associated-with"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
