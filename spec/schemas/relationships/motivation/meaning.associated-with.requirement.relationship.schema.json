{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Meaning associated-with Requirement",
  "description": "The meaning explains a term or concept the requirement relies on, such as the definition of 'session' in a timeout requirement.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.meaning.associated-with.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "motivation.meaning"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "associated-with"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
