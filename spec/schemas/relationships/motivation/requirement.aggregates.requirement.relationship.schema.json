{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirement Aggregates Requirement",
  "description": "The requirement is made up of narrower requirements, each part of meeting it. Use specializes instead when the narrower requirement is a variant rather than a part.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.requirement.aggregates.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "motivation.requirement"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "aggregates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
