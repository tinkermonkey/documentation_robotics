{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Principle Influence Requirement",
  "description": "The principle shapes a requirement without the requirement fully applying it. Use the requirement's realizes instead when the requirement makes the principle concrete for one system.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "motivation.principle.influence.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "motivation.principle"
    },
    "source_layer": {
      "const": "motivation"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "influence"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
