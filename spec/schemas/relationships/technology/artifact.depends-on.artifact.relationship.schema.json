{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifact depends-on Artifact",
  "description": "The artifact needs another artifact to be built or to run, such as a package and the packages it declares as dependencies.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "technology.artifact.depends-on.technology.artifact"
    },
    "source_spec_node_id": {
      "const": "technology.artifact"
    },
    "source_layer": {
      "const": "technology"
    },
    "destination_spec_node_id": {
      "const": "technology.artifact"
    },
    "destination_layer": {
      "const": "technology"
    },
    "predicate": {
      "const": "depends-on"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
