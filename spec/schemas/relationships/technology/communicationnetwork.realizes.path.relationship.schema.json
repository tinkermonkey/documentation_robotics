  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "technology.communicationnetwork.realizes.technology.path"
    },
    "source_spec_node_id": {
      "const": "technology.communicationnetwork"
    },
    "source_layer": {
