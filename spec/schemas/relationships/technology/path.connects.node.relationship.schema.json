{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Path connects Node",
  "description": "The node is an end of the path, such as a service host and its database host.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "technology.path.connects.technology.node"
    },
    "source_spec_node_id": {
      "const": "technology.path"
    },
    "source_layer": {
      "const": "technology"
    },
    "destination_spec_node_id": {
      "const": "technology.node"
    },
    "destination_layer": {
      "const": "technology"
    },
    "predicate": {
      "const": "connects"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
