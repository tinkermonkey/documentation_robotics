{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Device serves Applicationcomponent",
  "description": "The device runs the application component directly, such as firmware on an embedded board. Use a node instead when there is a hosting environment between them.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "technology.device.serves.application.applicationcomponent"
    },
    "source_spec_node_id": {
      "const": "technology.device"
    },
    "source_layer": {
      "const": "technology"
    },
    "destination_spec_node_id": {
      "const": "application.applicationcomponent"
    },
    "destination_layer": {
      "const": "application"
    },
    "predicate": {
      "const": "serves"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
