{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Node assigned-to Technologyprocess",
  "description": "The node performs the technology process, for example a CI runner performing a release pipeline.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "technology.node.assigned-to.technology.technologyprocess"
    },
    "source_spec_node_id": {
      "const": "technology.node"
    },
    "source_layer": {
      "const": "technology"
    },
    "destination_spec_node_id": {
      "const": "technology.technologyprocess"
    },
    "destination_layer": {
      "const": "technology"
    },
    "predicate": {
      "const": "assigned-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
