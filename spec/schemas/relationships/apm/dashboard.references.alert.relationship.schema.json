{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard references Alert",
  "description": "The dashboard shows the alert's state. Use monitors instead for the signals the dashboard charts.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.dashboard.references.apm.alert"
    },
    "source_spec_node_id": {
      "const": "apm.dashboard"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "apm.alert"
    },
    "destination_layer": {
      "const": "apm"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
