{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Logrecord flows-to Logprocessor",
  "description": "Records of this kind enter the log processor.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.logrecord.flows-to.apm.logprocessor"
    },
    "source_spec_node_id": {
      "const": "apm.logrecord"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "apm.logprocessor"
    },
    "destination_layer": {
      "const": "apm"
    },
    "predicate": {
      "const": "flows-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
