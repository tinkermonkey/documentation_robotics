{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Traceconfiguration depends-on Resource",
  "description": "The tracer provider is built with the resource, which it attaches to every span.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.traceconfiguration.depends-on.apm.resource"
    },
    "source_spec_node_id": {
      "const": "apm.traceconfiguration"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "apm.resource"
    },
    "destination_layer": {
      "const": "apm"
    },
    "predicate": {
      "const": "depends-on"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
