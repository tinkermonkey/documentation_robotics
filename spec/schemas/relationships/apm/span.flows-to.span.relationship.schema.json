{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Span Flows To Span",
  "description": "The span hands work on to a later span outside its parent-child tree, such as a message published here and consumed there. Use references instead for the parent.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.span.flows-to.apm.span"
    },
    "source_spec_node_id": {
      "const": "apm.span"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "apm.span"
    },
    "destination_layer": {
      "const": "apm"
    },
    "predicate": {
      "const": "flows-to"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
