{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Metricinstrument satisfies Requirement",
  "description": "The metric provides the measurement a requirement asks for, such as an SLO indicator.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.metricinstrument.satisfies.motivation.requirement"
    },
    "source_spec_node_id": {
      "const": "apm.metricinstrument"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "motivation.requirement"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "satisfies"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
