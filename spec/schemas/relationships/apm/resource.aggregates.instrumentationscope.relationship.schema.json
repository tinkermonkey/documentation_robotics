{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resource aggregates Instrumentationscope",
  "description": "The scope runs in the process the resource identifies, so its telemetry carries the resource.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.resource.aggregates.apm.instrumentationscope"
    },
    "source_spec_node_id": {
      "const": "apm.resource"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "apm.instrumentationscope"
    },
    "destination_layer": {
      "const": "apm"
    },
    "predicate": {
      "const": "aggregates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
