{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Metricconfiguration references Traceconfiguration",
  "description": "The metric configuration links metrics to traces from the trace configuration, such as through exemplars.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.metricconfiguration.references.apm.traceconfiguration"
    },
    "source_spec_node_id": {
      "const": "apm.metricconfiguration"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "apm.traceconfiguration"
    },
    "destination_layer": {
      "const": "apm"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
