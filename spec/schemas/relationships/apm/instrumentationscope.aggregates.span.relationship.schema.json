{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Instrumentationscope Aggregates Span",
  "description": "The span is started by a tracer obtained under the scope.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.instrumentationscope.aggregates.apm.span"
    },
    "source_spec_node_id": {
      "const": "apm.instrumentationscope"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "apm.span"
    },
    "destination_layer": {
      "const": "apm"
    },
    "predicate": {
      "const": "aggregates"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
