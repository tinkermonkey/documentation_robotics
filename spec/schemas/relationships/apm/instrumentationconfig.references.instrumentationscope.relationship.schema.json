{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Instrumentationconfig references Instrumentationscope",
  "description": "The instrumentation configuration names the scope its library emits telemetry under.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "apm.instrumentationconfig.references.apm.instrumentationscope"
    },
    "source_spec_node_id": {
      "const": "apm.instrumentationconfig"
    },
    "source_layer": {
      "const": "apm"
    },
    "destination_spec_node_id": {
      "const": "apm.instrumentationscope"
    },
    "destination_layer": {
      "const": "apm"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
