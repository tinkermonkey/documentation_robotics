{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ratelimit references Header",
  "description": "The rate limit reports its state in the header, such as X-RateLimit-Remaining.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.ratelimit.references.api.header"
    },
    "source_spec_node_id": {
      "const": "api.ratelimit"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "api.header"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
