{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ratelimit governs Pathitem",
  "description": "The rate limit caps calls to every operation on the path.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.ratelimit.governs.api.pathitem"
    },
    "source_spec_node_id": {
      "const": "api.ratelimit"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "api.pathitem"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "governs"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
