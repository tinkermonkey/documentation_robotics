{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Components composes Header",
  "description": "The header is a reusable definition in the components registry.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.components.composes.api.header"
    },
    "source_spec_node_id": {
      "const": "api.components"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "api.header"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
