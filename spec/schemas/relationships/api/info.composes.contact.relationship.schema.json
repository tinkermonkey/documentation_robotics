{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Info composes Contact",
  "description": "The contact is the info block's contact entry.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.info.composes.api.contact"
    },
    "source_spec_node_id": {
      "const": "api.info"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "api.contact"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
