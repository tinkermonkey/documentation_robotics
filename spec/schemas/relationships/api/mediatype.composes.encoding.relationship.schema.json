{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mediatype composes Encoding",
  "description": "The encoding fixes how one property of the media type's payload is serialized.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.mediatype.composes.api.encoding"
    },
    "source_spec_node_id": {
      "const": "api.mediatype"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "api.encoding"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
