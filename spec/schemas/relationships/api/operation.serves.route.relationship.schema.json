{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operation serves Route",
  "description": "The route calls the API operation to load its data, such as a loader fetching GET /orders/{id}.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.operation.serves.navigation.route"
    },
    "source_spec_node_id": {
      "const": "api.operation"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "navigation.route"
    },
    "destination_layer": {
      "const": "navigation"
    },
    "predicate": {
      "const": "serves"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
