{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operation references Threat",
  "description": "The operation is exposed to the threat, such as an endpoint open to enumeration.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.operation.references.security.threat"
    },
    "source_spec_node_id": {
      "const": "api.operation"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "security.threat"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "references"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
