{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Securityscheme realizes Securitypolicy",
  "description": "The scheme applies the authentication part of the security policy.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.securityscheme.realizes.security.securitypolicy"
    },
    "source_spec_node_id": {
      "const": "api.securityscheme"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "security.securitypolicy"
    },
    "destination_layer": {
      "const": "security"
    },
    "predicate": {
      "const": "realizes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
