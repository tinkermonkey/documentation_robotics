{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paths composes Pathitem",
  "description": "The path item is the entry for one path template.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.paths.composes.api.pathitem"
    },
    "source_spec_node_id": {
      "const": "api.paths"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "api.pathitem"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
