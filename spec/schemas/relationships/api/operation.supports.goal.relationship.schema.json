{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operation supports Goal",
  "description": "The operation contributes to the goal.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.operation.supports.motivation.goal"
    },
    "source_spec_node_id": {
      "const": "api.operation"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "motivation.goal"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "supports"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
