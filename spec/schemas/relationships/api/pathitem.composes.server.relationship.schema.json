{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pathitem composes Server",
  "description": "Operations on the path are called on the server instead of the document's.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.pathitem.composes.api.server"
    },
    "source_spec_node_id": {
      "const": "api.pathitem"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "api.server"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
