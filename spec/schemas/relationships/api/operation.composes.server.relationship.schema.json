{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operation composes Server",
  "description": "The operation is called on the server instead of the path's or document's.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.operation.composes.api.server"
    },
    "source_spec_node_id": {
      "const": "api.operation"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "api.server"
    },
    "destination_layer": {
      "const": "api"
    },
    "predicate": {
      "const": "composes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
