{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operation exposes Feature",
  "description": "Defines relationship: api.operation exposes product.feature",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.operation.exposes.product.feature"
    },
    "source_spec_node_id": {
      "const": "api.operation"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "product.feature"
    },
    "destination_layer": {
      "const": "product"
    },
    "predicate": {
      "const": "exposes"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
