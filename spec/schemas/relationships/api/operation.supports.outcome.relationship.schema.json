{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operation supports Outcome",
  "description": "The operation contributes to the outcome.",
  "allOf": [
    {
      "$ref": "../../base/spec-node-relationship.schema.json"
    }
  ],
  "properties": {
    "id": {
      "const": "api.operation.supports.motivation.outcome"
    },
    "source_spec_node_id": {
      "const": "api.operation"
    },
    "source_layer": {
      "const": "api"
    },
    "destination_spec_node_id": {
      "const": "motivation.outcome"
    },
    "destination_layer": {
      "const": "motivation"
    },
    "predicate": {
      "const": "supports"
    },
    "cardinality": {
      "const": "many-to-many"
    },
    "strength": {
      "const": "medium"
    }
  }
}
