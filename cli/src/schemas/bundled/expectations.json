          "direction": "incoming",
          "predicate": "realizes",
          "other": {
            "types": [
              "application.applicationservice",
              "technology.technologyservice",
              "product.feature"
            ]
          }
        },
        {
          "direction": "outgoing",
          "predicate": "aggregates",
          "other": {
            "types": ["product.softwarecapability"]
          }
        }
      ]
    },
    {
      "id": "product.userworkflow.composes-steps",
      "layer": "product",
      "source": "product.userworkflow",
      "rationale": "A user workflow composes its steps and reaches features only through them; a workflow with no steps describes nothing the user does.",
      "anyOf": [
        {
          "direction": "outgoing",
          "predicate": "composes",
          "other": {
            "types": ["product.workflowstep"]
          }
        }
      ]
    },
    {
      "id": "product.userworkflow.serves-persona",
      "layer": "product",
      "source": "product.userworkflow",
      "rationale": "User workflows serve the personas who perform them; a workflow that serves no persona has no stated user.",
      "anyOf": [
        {
          "direction": "outgoing",
          "predicate": "serves",
          "other": {
            "types": ["product.persona"]
          }
        }
      ]
    },
    {
      "id": "product.workflowstep.part-of-workflow",
      "layer": "product",
      "source": "product.workflowstep",
      "rationale": "A workflow step exists inside the user workflow that composes it.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "composes",
          "other": {
            "types": ["product.userworkflow"]
          }
        }
      ]
    },
    {
      "id": "product.workflowstep.uses-feature",
      "layer": "product",
      "source": "product.workflowstep",
      "rationale": "Each step uses the features it exercises; a step that uses none is not supported by the product.",
      "anyOf": [
        {
          "direction": "outgoing",
          "predicate": "uses",
          "other": {
            "types": ["product.feature"]
          }
        }
      ]
    },
    {
      "id": "security.countermeasure.counters",
      "layer": "security",
      "source": "security.countermeasure",
      "rationale": "A countermeasure exists to mitigate a threat or protect something; one that does neither counters nothing.",
      "anyOf": [
        {
          "direction": "outgoing",
          "predicate": "mitigates",
          "other": {
            "types": ["security.threat"]
          }
        },
        {
          "direction": "outgoing",
          "predicate": "protects"
        }
      ]
    },
    {
      "id": "security.role.grants-permissions",
      "layer": "security",
      "source": "security.role",
      "rationale": "A role grants access only through the permissions it aggregates; a role with none grants nothing.",
      "anyOf": [
        {
          "direction": "outgoing",
          "predicate": "aggregates",
          "other": {
            "types": ["security.permission"]
          }
        }
      ]
    },
    {
      "id": "security.threat.mitigated",
      "layer": "security",
      "source": "security.threat",
      "rationale": "A threat nothing mitigates is an open risk; a reviewer will ask what counters it, or whether it is accepted.",
      "anyOf": [
        {
          "direction": "incoming",
          "predicate": "mitigates"
        }
      ]
    },
    {
      "id": "technology.technologyservice.used",
      "layer": "technology",
      "source": "technology.technologyservice",
      "rationale": "A technology service exists to serve or realize something above it, or to be used; one nothing relies on is unexplained infrastructure.",
      "anyOf": [
        {
          "direction": "outgoing",
          "predicate": "serves"
        },
        {
          "direction": "outgoing",
          "predicate": "realizes"
        },
        {
          "direction": "incoming",
          "predicate": "uses"
        },
        {
          "direction": "incoming",
          "predicate": "depends-on"
        }
      ]
    },
    {
