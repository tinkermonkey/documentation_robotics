      "layer": "testing",
      "source": "testing.testcasesketch",
      "rationale": "A test case tests or validates something; one that names no target verifies nothing the model can trace.",
      "anyOf": [
        {
          "direction": "outgoing",
          "predicate": "tests"
        },
        {
          "direction": "outgoing",
          "predicate": "validates"
        }
      ]
    },
    {
      "id": "testing.testcoveragetarget.targets-something",
      "layer": "testing",
      "source": "testing.testcoveragetarget",
      "rationale": "A coverage target names the element it tests or covers; without one the coverage it measures is of nothing.",
      "anyOf": [
        {
          "direction": "outgoing",
          "predicate": "tests"
        },
        {
          "direction": "outgoing",
          "predicate": "covers"
        }
      ]
    },
    {
      "id": "ux.view.routed",
      "layer": "ux",
      "source": "ux.view",
      "rationale": "A route maps to the view it renders; a view no route renders cannot be reached.",
      "anyOf": [
