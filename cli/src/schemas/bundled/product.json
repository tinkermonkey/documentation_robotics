{
  "specVersion": "0.10.0",
  "layer": {
    "id": "product",
    "number": 3,
    "name": "Product Layer",
    "description": "Layer 3: Product Layer",
    "inspired_by": {
      "standard": "ArchiMate 3.2 Strategy Extension + Product Management Practice",
      "version": "3.2",
      "url": "https://pubs.opengroup.org/architecture/archimate32-doc/"
    },
    "node_types": [
      "product.capability",
      "product.feature",
      "product.milestone",
      "product.persona",
      "product.userworkflow"
    ]
  },
  "nodeSchemas": {
    "capability": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Capability",
      "description": "An ability the product possesses, independent of how it's implemented",
      "allOf": [
        {
          "$ref": "urn:dr:spec:base:spec-node"
        }
      ],
      "properties": {
        "spec_node_id": {
          "const": "product.capability"
        },
        "layer_id": {
          "const": "product"
        },
        "type": {
          "const": "capability"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "documentation": {
              "type": "string",
              "description": "Detailed description of the capability"
            },
            "status": {
              "type": "string",
              "enum": [
                "proposed",
                "planned",
                "developing",
                "delivered",
                "deprecated"
              ],
              "description": "Lifecycle status of the capability"
            },
            "properties": {
              "type": "object",
              "description": "Cross-layer properties"
            }
          },
          "required": ["status"],
          "additionalProperties": false
        }
      },
      "$id": "urn:dr:spec:node:product.capability"
    },
    "feature": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Feature",
      "description": "A user-visible unit of product functionality that delivers one or more capabilities",
      "allOf": [
        {
          "$ref": "urn:dr:spec:base:spec-node"
        }
      ],
      "properties": {
        "spec_node_id": {
          "const": "product.feature"
        },
        "layer_id": {
          "const": "product"
        },
        "type": {
          "const": "feature"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "documentation": {
              "type": "string",
              "description": "Detailed description of the feature"
            },
            "priority": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low", "informational"],
              "description": "Priority level"
            },
            "status": {
              "type": "string",
              "enum": [
                "proposed",
                "planned",
                "developing",
                "delivered",
                "deprecated"
              ],
              "description": "Lifecycle status of the feature"
            },
            "size": {
              "type": "string",
              "enum": ["xs", "s", "m", "l", "xl"],
              "description": "Relative sizing estimate"
            },
            "properties": {
              "type": "object",
              "description": "Cross-layer properties"
            }
          },
          "required": ["priority", "status"],
          "additionalProperties": false
        }
      },
      "$id": "urn:dr:spec:node:product.feature"
    },
    "milestone": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Milestone",
      "description": "A time-bound delivery target grouping features or capabilities",
      "allOf": [
        {
          "$ref": "urn:dr:spec:base:spec-node"
        }
      ],
      "properties": {
        "spec_node_id": {
          "const": "product.milestone"
        },
        "layer_id": {
          "const": "product"
        },
        "type": {
          "const": "milestone"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "documentation": {
              "type": "string",
              "description": "Detailed description of the milestone"
            },
            "status": {
              "type": "string",
              "enum": [
                "proposed",
                "planned",
                "active",
                "completed",
                "cancelled"
              ],
              "description": "Milestone status"
            }
          },
          "required": ["status"],
          "additionalProperties": false
        }
      },
      "$id": "urn:dr:spec:node:product.milestone"
    },
    "persona": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Persona",
      "description": "A user archetype representing a class of users with shared goals, behaviors, and pain points",
      "allOf": [
        {
          "$ref": "urn:dr:spec:base:spec-node"
        }
      ],
      "properties": {
        "spec_node_id": {
          "const": "product.persona"
        },
        "layer_id": {
          "const": "product"
        },
        "type": {
          "const": "persona"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "documentation": {
              "type": "string",
              "description": "Detailed description of the persona"
            },
            "category": {
              "type": "string",
              "enum": ["primary", "secondary", "served", "negative"],
              "description": "Persona classification by importance"
            },
            "proficiency": {
              "type": "string",
              "enum": ["novice", "intermediate", "advanced", "expert"],
              "description": "Technical proficiency level"
            }
          },
          "required": ["category", "proficiency"],
          "additionalProperties": false
        }
      },
      "$id": "urn:dr:spec:node:product.persona"
    },
    "userworkflow": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserWorkflow",
      "description": "A sequence of user-facing steps through the product to accomplish a goal",
      "allOf": [
        {
          "$ref": "urn:dr:spec:base:spec-node"
        }
      ],
      "properties": {
        "spec_node_id": {
          "const": "product.userworkflow"
        },
        "layer_id": {
          "const": "product"
        },
        "type": {
          "const": "userworkflow"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "documentation": {
              "type": "string",
              "description": "Detailed description of the user workflow"
            },
            "complexity": {
              "type": "string",
              "enum": ["simple", "moderate", "complex"],
              "description": "Workflow complexity assessment"
            },
            "properties": {
              "type": "object",
              "description": "Cross-layer properties"
            }
          },
          "required": ["complexity"],
          "additionalProperties": false
        }
      },
      "$id": "urn:dr:spec:node:product.userworkflow"
    }
  },
