# ============================================================================
# Stage 1: Base Environment Setup
# ============================================================================
FROM switchyard-orchestrator:latest

# The base image already includes:
# - Claude CLI (REQUIRED - must be present)
# - Git CLI (REQUIRED - must be present)
# - GitHub CLI (REQUIRED - must be present)
# - Python 3.11
# - Essential build tools
# - procps package (provides 'ps' command needed by Claude CLI)

USER root

# Install agent-specific entrypoint that builds the CLI after source mount
# The entrypoint runs `npm run build` in cli/ when dist/cli.js is missing,
# ensuring integration tests have the compiled CLI binary available.
COPY docker-entrypoint-agent.sh /usr/local/bin/docker-entrypoint-agent.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-agent.sh
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-agent.sh"]

# GitHub authentication: The orchestrator passes GITHUB_TOKEN at runtime
# via `docker run -e GITHUB_TOKEN=...`. The base image entrypoint
# (/usr/local/bin/docker-entrypoint.sh) runs `gh auth login --with-token`
# when GITHUB_TOKEN is set. No ENV declaration needed here — runtime
# environment variables are picked up automatically.

# Disable keyring-based credential storage for gh CLI.
ENV GH_NO_KEYRING=1
ENV GH_NO_UPDATE_NOTIFIER=1
ENV GH_CONFIG_DIR=/home/orchestrator/.config/gh

# ============================================================================
# Stage 2: Install Project-Specific Runtimes
# ============================================================================
# This project uses:
# - Python for the validation CLI (cli-validation/python-cli/)
# - Node.js/Bun for the main TypeScript CLI (cli/)

# Install system dependencies for lxml and Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2-dev \
    libxslt1-dev \
    curl \
    unzip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Bun runtime globally via npm (more reliable than curl installer)
RUN npm install -g bun

# Install codebase-memory-mcp MCP server for code knowledge graph analysis
RUN npm install -g codebase-memory-mcp

# ============================================================================
# Stage 3: Pre-install Dependencies at /opt/deps
# ============================================================================
# CRITICAL: Dependencies MUST be baked outside /workspace entirely.
# The runtime bind mount replaces the ENTIRE /workspace subtree, so anything
# baked under /workspace (including /workspace/node_modules) is shadowed.
# /opt/deps sits outside that subtree and is extracted into each worktree
# by the orchestrator's baked_dependency_extractor at creation time.
WORKDIR /opt/deps

# Pre-install root Node.js dependencies (needed for build:spec via tsx)
COPY package.json package-lock.json /tmp/root-deps/
RUN cd /tmp/root-deps && \
    npm install --ignore-scripts --cache /home/orchestrator/.npm && \
    mv /tmp/root-deps/node_modules /opt/deps/node_modules && \
    rm -rf /tmp/root-deps

# Pre-install CLI Node.js dependencies (includes TypeScript compiler)
# tsc is required by pre-commit hooks (npm run lint, npm run type-check)
COPY cli/package.json cli/package-lock.json /tmp/cli-deps/
RUN cd /tmp/cli-deps && \
    npm install --cache /home/orchestrator/.npm && \
    mkdir -p /opt/deps/cli && \
    mv /tmp/cli-deps/node_modules /opt/deps/cli/node_modules && \
    rm -rf /tmp/cli-deps

# Verify tsc is available in baked dependencies
RUN /opt/deps/cli/node_modules/.bin/tsc --version

# Pre-install Python dependencies
# Core CLI dependencies
RUN pip install --no-cache-dir \
    'click>=8.1.0' \
    'pyyaml>=6.0' \
    'jsonschema>=4.17.0' \
    'pydantic>=2.0.0' \
    'rich>=13.0.0' \
    'python-dateutil>=2.8.0' \
    'packaging>=23.0'

# Template and graph dependencies
RUN pip install --no-cache-dir \
    'jinja2>=3.1.0' \
    'networkx>=3.0' \
    'jsonpath-ng>=1.5.0' \
    'lxml>=4.9.0' \
    'markdown>=3.4.0'

# Interactive prompts and text processing
RUN pip install --no-cache-dir \
    'questionary>=2.0.0' \
    'inflect>=7.0.0'

# Web server for visualization (aiohttp + watchdog)
RUN pip install --no-cache-dir \
    'aiohttp>=3.9.0' \
    'watchdog>=3.0.0'

# AI chat integration
RUN pip install --no-cache-dir \
    'anthropic>=0.75.0'

# Test stack (dev dependencies)
RUN pip install --no-cache-dir \
    'pytest>=7.0.0' \
    'pytest-cov>=4.0.0' \
    'pytest-asyncio>=0.21.0' \
    'pre-commit>=3.0.0' \
    'black>=23.0.0' \
    'mypy>=1.0.0' \
    'ruff>=0.1.0' \
    'types-PyYAML' \
    'types-python-dateutil'

# ============================================================================
# Stage 4: Ownership and Permissions
# ============================================================================
RUN chown -R orchestrator:orchestrator /opt/deps /home/orchestrator/.npm

# Ensure /tmp has proper permissions for test golden copy operations.
RUN chmod 1777 /tmp

# ============================================================================
# Stage 5: Switch to Runtime User
# ============================================================================
USER orchestrator

# ============================================================================
# Stage 6: Verification (MANDATORY)
# ============================================================================
# Ensure a clean gh config directory exists for the orchestrator user.
RUN mkdir -p "$GH_CONFIG_DIR" && \
    rm -f "$GH_CONFIG_DIR/hosts.yml" && \
    printf 'version: 1\n' > "$GH_CONFIG_DIR/config.yml"

# Verify all critical CLIs are present (from base image)
RUN claude --version && \
    git --version && \
    gh --version

# Verify Node.js/Bun runtimes
RUN node --version && \
    npm --version && \
    bun --version && \
    codebase-memory-mcp --version

# Verify TypeScript compiler is available in baked deps
RUN /opt/deps/cli/node_modules/.bin/tsc --version

# Verify project-specific tools - core Python dependencies
RUN python3 --version && \
    pip --version && \
    python3 -c "import click; import pydantic; import jsonschema; import networkx; print('Core dependencies available')"

# Verify visualization server dependencies
RUN python3 -c "import aiohttp; import watchdog; print('Visualization server dependencies available')"

# Verify test stack dependencies
RUN python3 -c "import pytest; import pytest_cov; import pytest_asyncio; print('Test stack dependencies available')"

# Verify AI integration
RUN python3 -c "import anthropic; print('Anthropic SDK available')"

# ============================================================================
# Default command
# ============================================================================
CMD ["/bin/bash"]
